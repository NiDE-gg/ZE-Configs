// GENERATED by ze_vermintide_vscript/compilepal/make_live.py - the released map's live scripts (Stripper points
// horde_logic here). Edit ze_vermintide_vscript/, then run make_live.py again - changes made here are overwritten.
// ============================================================================
// ze_vermintide - entry script of the VScript framework in vt/.
// It keeps the old name so the map needs no Hammer change: the logic_script "horde_logic"
// runs this file every round and main_lift_move's OnFullyOpen calls StartHordeTimer.
//
// CS:S re-creates the logic_script every round. The vt/ files are compiled once per map;
// later rounds only run the per-round resets (VT.EveryRound). After editing a vt/ file,
// change map (or type "!vt reload" and restart the round) to load the new code.
// ============================================================================

if (!("VT" in getroottable())) ::VT <- {}
::VT.Build <- "2026-10-17 r107 (random monsters, no repeats)"

if (!("VTLoaded" in getroottable()) || !::VTLoaded)
{
	::VT.RoundHooks <- []
	// one plain line per file, so CompilePal packs them all
	IncludeScript("ze_vermintide/vt/core.nut")
	IncludeScript("ze_vermintide/vt/config.nut")
	IncludeScript("ze_vermintide/vt/modelfix.nut")
	IncludeScript("ze_vermintide/vt/seqdur.nut")
	IncludeScript("ze_vermintide/vt/puppet.nut")
	IncludeScript("ze_vermintide/vt/camera.nut")
	IncludeScript("ze_vermintide/vt/items.nut")
	IncludeScript("ze_vermintide/vt/careers.nut")
	IncludeScript("ze_vermintide/vt/summons.nut")
	IncludeScript("ze_vermintide/vt/specials.nut")
	IncludeScript("ze_vermintide/vt/passives.nut")
	IncludeScript("ze_vermintide/vt/talents.nut")
	IncludeScript("ze_vermintide/vt/director.nut")
	IncludeScript("ze_vermintide/vt/ambient.nut")
	IncludeScript("ze_vermintide/vt/rats.nut")
	IncludeScript("ze_vermintide/vt/levels.nut")
	IncludeScript("ze_vermintide/vt/score.nut")
	IncludeScript("ze_vermintide/vt/bombs.nut")
	IncludeScript("ze_vermintide/vt/mapflow.nut")
	IncludeScript("ze_vermintide/vt/cutscene.nut")
	IncludeScript("ze_vermintide/vt/radar.nut")
	IncludeScript("ze_vermintide/vt/loot.nut")
	IncludeScript("ze_vermintide/vt/npc.nut")
	IncludeScript("ze_vermintide/vt/npclines.nut")
	IncludeScript("ze_vermintide/vt/voice.nut")
	IncludeScript("ze_vermintide/vt/voicelines.nut")
	IncludeScript("ze_vermintide/vt/musiclen.nut")
	IncludeScript("ze_vermintide/vt/menu.nut")
	IncludeScript("ze_vermintide/vt/hooks.nut")
	::VTLoaded <- true

	// one function per file, so a file that failed to load shows up here
	local checks = [
		["core.nut", @() "Later" in VT],
		["config.nut", @() "Cfg" in VT],
		["seqdur.nut", @() "SeqDur" in VT],
		["puppet.nut", @() "Puppet" in VT && "Attach" in VT.Puppet],
		["camera.nut", @() "Camera" in VT && "Enable" in VT.Camera],
		["items.nut", @() "Items" in VT && "Spawn" in VT.Items],
		["careers.nut", @() "ItemDefs" in VT && "merc" in VT.ItemDefs],
		["summons.nut", @() "Summons" in VT],
		["specials.nut", @() "ItemDefs" in VT && "ratogre" in VT.ItemDefs],
		["director.nut", @() "Director" in VT && "Start" in VT.Director],
		["ambient.nut", @() "Ambient" in VT && "SpawnLootNpc" in VT.Ambient],
		["passives.nut", @() "Passive" in VT && "passiveDesc" in VT.ItemDefs.merc],
		["talents.nut", @() "Talents" in VT && "Apply" in VT.Talents && "necromancer" in VT.TalentDefs],
		["levels.nut", @() "Levels" in VT && "Award" in VT.Levels],
		["score.nut", @() "Score" in VT && "OnRoundEnd" in VT.Score],
		["bombs.nut", @() "Bomb" in VT && "OnDetonate" in VT.Bomb],
		["mapflow.nut", @() "Map" in VT && "DoorTouch" in VT.Map],
		["cutscene.nut", @() "Cutscene" in VT && "Start" in VT.Cutscene],
		["radar.nut", @() "Radar" in VT && "Give" in VT.Radar],
		["rats.nut", @() "Rats" in VT && "SpawnGroup" in VT.Rats],
		["loot.nut", @() "Loot" in VT && "SpawnChests" in VT.Loot],
		["npc.nut", @() "Npc" in VT && "Say" in VT.Npc],
		["npclines.nut", @() "NpcDur" in VT],
		["voice.nut", @() "Voice" in VT && "Say" in VT.Voice],
		["voicelines.nut", @() "VoiceLinesBuilt" in VT],
		["musiclen.nut", @() "MusicLen" in VT],
		["menu.nut", @() "Menu" in VT && "Open" in VT.Menu],
		["hooks.nut", @() "OnTakeDamage" in VT],
	];
	local ok = 0;
	foreach (c in checks)
	{
		local good = false;
		try { good = c[1]() } catch (e) {}
		if (good) ok++;
		else printl("[VT] FAILED TO LOAD ze_vermintide/vt/" + c[0]);
	}
	printl("[VT] " + ok + " of " + checks.len() + " files loaded - build " + VT.Build);
	if (ok == checks.len())
	{
		VT.PrecacheAll();
		VT.PrecacheParticles();
		VT.Voice.Precache();
	}
}
else
{
	foreach (fn in VT.RoundHooks) fn()
	printl("[VT] round " + VT.Round + " - build " + VT.Build + " (scripts compiled at map load: change map to load edits)");
}

// ----------------------------------------------------------------------------- every round
// (these need this round's logic_script, so they can't live in the vt/ files)

function CollectEventsInScope(events)
{
	local events_id = UniqueString()
	getroottable()[events_id] <- events
	local events_table = getroottable()[events_id]
	local Instance = self
	foreach (name, callback in events)
	{
		local callback_binded = callback.bindenv(this)
		events_table[name] = @(params) Instance.IsValid() ? callback_binded(params) : delete getroottable()[events_id]
	}
	__CollectGameEventCallbacks(events_table)
}

CollectEventsInScope
({
	OnGameEvent_player_spawn = function(params) { VT.Guard("player_spawn", @() VT.OnPlayerSpawn(params)) }
	OnGameEvent_player_death = function(params) { VT.Guard("player_death", @() VT.OnPlayerDeath(params)) }
	OnGameEvent_round_end = function(params) { VT.Guard("round_end", @() VT.OnRoundEnd(params)) }
	OnGameEvent_player_say = function(params) { VT.Guard("player_say", @() VT.OnPlayerSay(params)) }
	OnGameEvent_player_disconnect = function(params) { VT.Guard("player_disconnect", @() VT.OnPlayerDisconnect(params)) }
	OnGameEvent_hegrenade_detonate = function(params) { VT.Guard("hegrenade_detonate", @() VT.Bomb.OnDetonate(params)) }
	OnGameEvent_bullet_impact = function(params) { VT.Guard("bullet_impact", @() VT.Rats.OnBulletImpact(params)) }
	OnGameEvent_player_hurt = function(params) { VT.Guard("player_hurt", @() VT.OnPlayerHurt(params)) }
	OnScriptHook_OnTakeDamage = function(params) { VT.Guard("damage", @() VT.OnTakeDamage(params)) }
})

VT.EnsureThink()

// Hammer: main_lift_move OnFullyOpen -> horde_logic CallScriptFunction StartHordeTimer
function StartHordeTimer()
{
	VT.Director.Start()
}

// Hammer: countdown_relay / main_lift_trigger_1 -> horde_logic CallScriptFunction StartAmbientMusic
// (ambient music before the director runs; once it runs, it picks the music itself)
// (old) chest_item_case OnCase05 -> ChestBomb: a VT2 bomb / potion for the activator (loot.nut runs the chests now)
function ChestBomb()
{
	if (activator != null && activator.IsValid() && activator.IsPlayer()) VT.Bomb.Drop(activator)
}

// ---- the map's flow (mapflow.nut) - what the old manager1 / zombie_detection / giveknife scripts did
// map1manager1 OnUser1..3, platform_lift_move_2: horde_logic RunScriptCode MapTeleportZombies(`tp_hub_dest`)
function MapTeleportZombies(name) { VT.Map.TeleportZombies(name) }
// map1manager1 OnUser4: the zombies to the marker nearest the humans
function MapZombiesNearHumans() { VT.Map.ZombiesNearHumans() }
// every point_servercommand "say" announcement: horde_logic RunScriptCode MapSay(`Gate opens in 25 seconds`)
function MapSay(text) { VT.Map.Say(text) }
// countdown_relay: horde_logic CallScriptFunction MapCountdown
function MapCountdown() { VT.Map.Countdown() }
// the final room's trigger (optional - the Bridge of Shadows' announcement starts it too): horde_logic CallScriptFunction MapFinalStand
function MapFinalStand() { VT.Director.FinalStand() }
// keep_portal_to_win: horde_logic CallScriptFunction MapKillAllZombies - the zombies, and every human who didn't escape
function MapKillAllZombies() { VT.Map.EndingKill() }
// keep_portal_to_win, for every human through (the Stripper cfg's output): horde_logic CallScriptFunction MapEscaped
function MapEscaped() { VT.Map.Escaped(activator) }
// the zombies' knife teleport: horde_logic CallScriptFunction MapZombieKnife
function MapZombieKnife() { VT.Map.GiveKnife(activator) }
// the late-zombie portals: horde_logic CallScriptFunction MapCatchupArrive (their smoke and boost on arrival)
function MapCatchupArrive() { VT.Map.CatchupArrive(activator) }

// tp_to_<hero> OnStartTouch -> horde_logic CallScriptFunction HeroPortal (added by the script each round)
function HeroPortal()
{
	VT.Items.OnHeroPortal(activator, caller)
}

// vt_dev_button (the dev room, by the player models) OnPressed -> horde_logic CallScriptFunction DevButton
function DevButton()
{
	if (activator != null && activator.IsValid() && activator.IsPlayer()) VT.ToggleDev(activator)
}

// The map switches "hordes wait for their monster": horde_logic CallScriptFunction MonsterHoldOn / Off / Toggle
function MonsterHoldOn() { VT.Cfg.HordeWaitsForMonster = true }
function MonsterHoldOff() { VT.Cfg.HordeWaitsForMonster = false }
function MonsterHoldToggle() { VT.Cfg.HordeWaitsForMonster = !VT.Cfg.HordeWaitsForMonster }

// A one-way door / lift closed behind the humans: forget their trail, so no horde lands behind it
// (horde_logic CallScriptFunction HordeTrailClear)
function HordeTrailClear() { VT.Director.ClearTrail() }

function StartAmbientMusic()
{
	if (!VT.Dir.started) VT.Director.PlayMusic("ambient")
}
